{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Flow",
  "version": "0.1.0",
  "identifier": "com.codexflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Flow",
        "width": 280,
        "height": 62,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/tray-icon.ico"
    ],
    "targets": "all"
  }
}
